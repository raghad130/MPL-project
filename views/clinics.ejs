<%- include('./partials/header') %>

<main class="container mt-4">
  <h1><%= heading %></h1>

  <div class="row mt-3"></div>
<% for (let clinic of clinics) { %>
  <div class="col-md-4 mb-3">
    <div class="card p-3">
      <h5><%= clinic.name %></h5>
      <p class="mb-2">Specialty: <%= clinic.specialty %></p>

      <% if (clinic.open) { %>
        <span class="badge bg-success mb-2">Accepting Visits</span>
      <% } else { %>
        <span class="badge bg-secondary mb-2">Currently Full</span>
      <% } %>

      <a href="/clinics/<%= clinic.id %>" class="btn btn-primary btn-sm">View Details</a>
    </div>
  </div>
<% } %>
  </div>
</main>

<%- include('./partials/footer') %>