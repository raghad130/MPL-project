<%- include('./partials/header') %>

<main class="container mt-4">
  <h1><%= heading %></h1>
  <p class="mb-4">Have a question about clinic availability or visit requests? Send us a message below.</p>

  <form class="col-md-6">
    <div class="mb-3">
      <label for="fullName" class="form-label">Full Name</label>
      <input type="text" class="form-control" id="fullName" placeholder="Enter your full name" required>
    </div>

    <div class="mb-3">
      <label for="email" class="form-label">Email Address</label>
      <input type="email" class="form-control" id="email" placeholder="name@example.com" required>
    </div>

    <div class="mb-3">
      <label for="subject" class="form-label">Clinic or Topic</label>
      <select class="form-select" id="subject">
        <option value="general">General Inquiry</option>
        <option value="booking">Visit Request Help</option>
        <option value="clinic">Partner Clinic Question</option>
      </select>
    </div>

    <div class="mb-3">
      <label for="message" class="form-label">Message</label>
      <textarea class="form-control" id="message" rows="4" placeholder="Write your message here..." required></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Send Message</button>
  </form>
</main>

<%- include('./partials/footer') %>